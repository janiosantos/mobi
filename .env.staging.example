# Application
APP_NAME=MOBI
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=https://api-staging.mobi.com.br

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mobi_staging
DB_USERNAME=mobi_staging_user
DB_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids

# Broadcasting
BROADCAST_DRIVER=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=https

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@mobi.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Google Maps API
GOOGLE_MAPS_API_KEY=

# MercadoPago (Payment Gateway)
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS=/var/www/storage/firebase-credentials.json
FCM_SERVER_KEY=

# AWS S3 (or MinIO for staging)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mobi-staging
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# MinIO (S3-compatible)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://minio:9000

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
LOG_SLACK_WEBHOOK_URL=

# Security
SANCTUM_STATEFUL_DOMAINS=api-staging.mobi.com.br
SESSION_DOMAIN=.mobi.com.br
