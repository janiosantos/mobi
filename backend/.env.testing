APP_NAME="MOBI Test"
APP_ENV=testing
APP_KEY=base64:TESTKEY1234567890TESTKEY1234567890TESTKEY1234=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=null
LOG_LEVEL=emergency

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

MAIL_MAILER=array

BROADCAST_DRIVER=log

# Google Maps API (use test values)
GOOGLE_MAPS_API_KEY=test_key
GOOGLE_GEOCODING_API_KEY=test_key
GOOGLE_DIRECTIONS_API_KEY=test_key
GOOGLE_DISTANCE_MATRIX_API_KEY=test_key

# MercadoPago (test mode)
MERCADOPAGO_PUBLIC_KEY=TEST_PUBLIC_KEY
MERCADOPAGO_ACCESS_TOKEN=TEST_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=test_secret
MERCADOPAGO_SANDBOX=true

# Firebase
FCM_SERVER_KEY=test_server_key
FCM_SENDER_ID=test_sender_id

# Twilio
TWILIO_SID=test_sid
TWILIO_AUTH_TOKEN=test_token
TWILIO_FROM=+15555555555
