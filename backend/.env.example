# Application
APP_NAME="MOBI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Frontend URLs
FRONTEND_URL=http://localhost:3000
PASSENGER_APP_URL=mobi://passenger
DRIVER_APP_URL=mobi://driver

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mobi
DB_USERNAME=mobi
DB_PASSWORD=secret

# Redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# Cache
CACHE_DRIVER=redis
CACHE_PREFIX=mobi_cache

# Queue
QUEUE_CONNECTION=redis
QUEUE_PREFIX=mobi_queue

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
BROADCAST_DRIVER=pusher
BROADCAST_CONNECTION=pusher

# Filesystem
FILESYSTEM_DISK=local

# AWS S3 (Production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher / WebSockets
PUSHER_APP_ID=mobi
PUSHER_APP_KEY=mobiappkey
PUSHER_APP_SECRET=mobiappsecret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# WebSockets Server
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=6001
WEBSOCKET_TLS=false

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_GUARD=web

# JWT
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Google Maps API
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=
GOOGLE_DISTANCE_MATRIX_API_KEY=

# MercadoPago
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true

# Firebase Cloud Messaging
FCM_SERVER_KEY=
FCM_SENDER_ID=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@mobi.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Application Settings
RIDE_SEARCH_RADIUS=5000
RIDE_ACCEPTANCE_TIMEOUT=60
RIDE_WAITING_TIMEOUT=300
RIDE_CANCEL_PENALTY=5.00
DRIVER_LOCATION_UPDATE_INTERVAL=5

# Pricing
BASE_FARE=5.00
PRICE_PER_KM=2.50
PRICE_PER_MINUTE=0.50
MINIMUM_FARE=8.00
SURGE_PRICING_ENABLED=true
SURGE_MAX_MULTIPLIER=3.0

# Commission
PLATFORM_COMMISSION_PERCENTAGE=25
DRIVER_PAYOUT_FREQUENCY=weekly

# Documents Validation
DRIVER_APPROVAL_REQUIRED=true
DOCUMENT_VERIFICATION_PROVIDER=manual

# Rate Limiting
API_RATE_LIMIT=60
API_RATE_LIMIT_DRIVER=120

# Horizon
HORIZON_DOMAIN=localhost:8000
HORIZON_PATH=horizon
HORIZON_PREFIX=horizon:

# Telescope (Development only)
TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope

# Filament
FILAMENT_PATH=admin
FILAMENT_DOMAIN=null

# Vite
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Development
DEBUGBAR_ENABLED=false
QUERY_DETECTOR_ENABLED=false
