// **************************************************************************
// JsonSerializableGenerator
// **************************************************************************

Payment _$PaymentFromJson(Map<String, dynamic> json) => Payment(
      id: (json['id'] as num).toInt(),
      paymentNumber: json['payment_number'] as String,
      rideId: (json['ride_id'] as num).toInt(),
      userId: (json['user_id'] as num).toInt(),
      paymentType: json['payment_type'] as String,
      amount: (json['amount'] as num).toDouble(),
      platformFee: (json['platform_fee'] as num?)?.toDouble(),
      driverAmount: (json['driver_amount'] as num?)?.toDouble(),
      status: json['status'] as String,
      gateway: json['gateway'] as String,
      gatewayPaymentId: json['gateway_payment_id'] as String?,
      pixQrCode: json['pix_qr_code'] as String?,
      pixQrCodeBase64: json['pix_qr_code_base64'] as String?,
      cardBrand: json['card_brand'] as String?,
      cardLastFour: json['card_last_four'] as String?,
      installments: (json['installments'] as num?)?.toInt(),
      createdAt: json['created_at'] == null
          ? null
          : DateTime.parse(json['created_at'] as String),
      processedAt: json['processed_at'] == null
          ? null
          : DateTime.parse(json['processed_at'] as String),
    );

Map<String, dynamic> _$PaymentToJson(Payment instance) => <String, dynamic>{
      'id': instance.id,
      'payment_number': instance.paymentNumber,
      'ride_id': instance.rideId,
      'user_id': instance.userId,
      'payment_type': instance.paymentType,
      'amount': instance.amount,
      'platform_fee': instance.platformFee,
      'driver_amount': instance.driverAmount,
      'status': instance.status,
      'gateway': instance.gateway,
      'gateway_payment_id': instance.gatewayPaymentId,
      'pix_qr_code': instance.pixQrCode,
      'pix_qr_code_base64': instance.pixQrCodeBase64,
      'card_brand': instance.cardBrand,
      'card_last_four': instance.cardLastFour,
      'installments': instance.installments,
      'created_at': instance.createdAt?.toIso8601String(),
      'processed_at': instance.processedAt?.toIso8601String(),
    };
